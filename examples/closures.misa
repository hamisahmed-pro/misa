// Phase 5a: first-class functions — closures, fn values, higher-order fns.

fn double(x: Int) -> Int {
  return x * 2
}

fn apply(f: (Int) -> Int, v: Int) -> Int {
  return f(v)
}

fn make_adder(n: Int) -> (Int) -> Int {
  return |x: Int| x + n
}

fn compose(f: (Int) -> Int, g: (Int) -> Int) -> (Int) -> Int {
  return |x: Int| f(g(x))
}

// an `fn` declaration used as a value
let g = double
print(g(21))

// passing functions and lambdas
print(apply(double, 5))
print(apply(|x: Int| x + 1, 10))

// untyped lambda params infer from the annotation
let h: (Int) -> Int = |x| x * 3
print(h(7))

// closures capture their defining scope
let add5 = make_adder(5)
print(add5(10))

// shared mutable state through a closure cell
var count = 0
let inc = || {
  count = count + 1
  return count
}
print(inc())
print(inc())
print(count)

// higher-order composition
let f = compose(|x: Int| x + 1, |x: Int| x * 10)
print(f(5))
