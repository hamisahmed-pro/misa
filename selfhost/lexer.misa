// Misa self-hosted lexer (Phase 6a).
//
// Mirrors impl/misa/lexer.py exactly: Go-style implicit semicolon
// insertion, line/block comments, strings with escapes, triple-quoted
// strings, numbers (int/float/duration/money), multi-char operators.
//
// Token representation: unlike the Python lexer (which stores parsed
// numbers), the `text` field always holds the RAW lexeme. The Misa
// parser will parse numbers later with int()/float().
//
// Entry point: lex(src: Text) -> [Tok]

type Tok {
    kind: Text,
    text: Text,
    line: Int,
    col: Int
}

// Lexer cursor state, threaded explicitly through functions
// (Misa functions cannot see module-level vars).
type Lx {
    src: Text,
    i: Int,
    line: Int,
    col: Int
}

// Result of lexing one token: the token plus the new cursor state.
type LexResult {
    tok: Tok,
    st: Lx
}

// -- character classification ------------------------------------------

fn make_lx(src: Text, i: Int, line: Int, col: Int) -> Lx {
    let r: Lx = { src: src, i: i, line: line, col: col }
    return r
}

fn make_tok(kind: Text, text: Text, line: Int, col: Int) -> Tok {
    let t: Tok = { kind: kind, text: text, line: line, col: col }
    return t
}

fn make_result(tok: Tok, st: Lx) -> LexResult {
    let r: LexResult = { tok: tok, st: st }
    return r
}

fn is_digit(c: Text) -> Bool {
    if len(c) == 0 {
        return false
    }
    return c >= "0" and c <= "9"
}

fn is_alpha(c: Text) -> Bool {
    if len(c) == 0 {
        return false
    }
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
}

fn is_alnum(c: Text) -> Bool {
    return is_digit(c) or is_alpha(c)
}

fn is_ident_char(c: Text) -> Bool {
    return is_alnum(c) or c == "_"
}

// -- cursor helpers -----------------------------------------------------

fn peek(st: Lx, n: Int) -> Text {
    let j = st.i + n
    if j < len(st.src) {
        return st.src[j]
    }
    return ""
}

fn advance(st: Lx, n: Int) -> Lx {
    let s = str.slice(st.src, st.i, st.i + n)
    var line = st.line
    var col = st.col
    for c in s {
        if c == "\n" {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
    }
    return make_lx(st.src, st.i + n, line, col)
}

fn at_end(st: Lx) -> Bool {
    return st.i >= len(st.src)
}

// -- keyword / semicolon tables ------------------------------------------

fn is_keyword(w: Text) -> Bool {
    if w == "app" { return true }
    if w == "model" { return true }
    if w == "type" { return true }
    if w == "screen" { return true }
    if w == "let" { return true }
    if w == "var" { return true }
    if w == "if" { return true }
    if w == "else" { return true }
    if w == "for" { return true }
    if w == "in" { return true }
    if w == "while" { return true }
    if w == "return" { return true }
    if w == "stream" { return true }
    if w == "await" { return true }
    if w == "on" { return true }
    if w == "budget" { return true }
    if w == "prompt" { return true }
    if w == "with" { return true }
    if w == "eval" { return true }
    if w == "given" { return true }
    if w == "expect" { return true }
    if w == "runs" { return true }
    if w == "provider" { return true }
    if w == "models" { return true }
    if w == "true" { return true }
    if w == "false" { return true }
    if w == "and" { return true }
    if w == "or" { return true }
    if w == "not" { return true }
    if w == "navigate" { return true }
    if w == "env" { return true }
    if w == "nil" { return true }
    if w == "fn" { return true }
    if w == "import" { return true }
    if w == "try" { return true }
    if w == "catch" { return true }
    if w == "throw" { return true }
    return false
}

fn inserts_semi(kind: Text) -> Bool {
    if kind == "IDENT" { return true }
    if kind == "INT" { return true }
    if kind == "FLOAT" { return true }
    if kind == "STRING" { return true }
    if kind == "DURATION" { return true }
    if kind == "MONEY" { return true }
    if kind == ")" { return true }
    if kind == "]" { return true }
    if kind == "}" { return true }
    if kind == "true" { return true }
    if kind == "false" { return true }
    if kind == "nil" { return true }
    if kind == "return" { return true }
    return false
}

fn is_multi_op(two: Text) -> Bool {
    if two == "==" { return true }
    if two == "!=" { return true }
    if two == "<=" { return true }
    if two == ">=" { return true }
    if two == "->" { return true }
    return false
}

fn is_symbol(c: Text) -> Bool {
    if c == "+" { return true }
    if c == "-" { return true }
    if c == "*" { return true }
    if c == "/" { return true }
    if c == "%" { return true }
    if c == "(" { return true }
    if c == ")" { return true }
    if c == "[" { return true }
    if c == "]" { return true }
    if c == "{{" { return true }
    if c == "}" { return true }
    if c == "." { return true }
    if c == "," { return true }
    if c == ":" { return true }
    if c == "|" { return true }
    if c == "=" { return true }
    if c == "?" { return true }
    if c == "<" { return true }
    if c == ">" { return true }
    if c == "!" { return true }
    return false
}

// -- comments ------------------------------------------------------------

fn skip_line_comment(st: Lx) -> Lx {
    var s = advance(st, 2)
    while s.i < len(s.src) and peek(s, 0) != "\n" {
        s = advance(s, 1)
    }
    return s
}

fn skip_block_comment(st: Lx) -> Lx {
    var s = advance(st, 2)
    var done = false
    while not done {
        if s.i >= len(s.src) {
            throw {code: "E001", message: "unterminated block comment"}
        }
        if peek(s, 0) == "*" and peek(s, 1) == "/" {
            s = advance(s, 2)
            done = true
        } else {
            s = advance(s, 1)
        }
    }
    return s
}

// -- token lexers ----------------------------------------------------------

fn lex_ident(st: Lx) -> LexResult {
    let line = st.line
    let col = st.col
    var s = st
    var buf = ""
    while is_ident_char(peek(s, 0)) {
        buf = buf + peek(s, 0)
        s = advance(s, 1)
    }
    var kind = "IDENT"
    if is_keyword(buf) {
        kind = buf
    }
    return make_result(make_tok(kind, buf, line, col), s)
}

fn lex_number(st: Lx) -> LexResult {
    let line = st.line
    let col = st.col
    var s = st
    var buf = ""
    while is_digit(peek(s, 0)) {
        buf = buf + peek(s, 0)
        s = advance(s, 1)
    }
    var is_float = false
    if peek(s, 0) == "." and is_digit(peek(s, 1)) {
        is_float = true
        buf = buf + "."
        s = advance(s, 1)
        while is_digit(peek(s, 0)) {
            buf = buf + peek(s, 0)
            s = advance(s, 1)
        }
    }
    // duration suffix? ("ms" before "s"; must not be followed by
    // an identifier char, so "5second" is not a duration)
    var suffix = ""
    if peek(s, 0) == "m" and peek(s, 1) == "s" and not is_ident_char(peek(s, 2)) {
        suffix = "ms"
    } else {
        if peek(s, 0) == "s" and not is_ident_char(peek(s, 1)) {
            suffix = "s"
        }
    }
    if suffix != "" {
        buf = buf + suffix
        if suffix == "ms" {
            s = advance(s, 2)
        } else {
            s = advance(s, 1)
        }
        return make_result(make_tok("DURATION", buf, line, col), s)
    }
    var kind = "INT"
    if is_float {
        kind = "FLOAT"
    }
    return make_result(make_tok(kind, buf, line, col), s)
}

fn lex_money(st: Lx) -> LexResult {
    let line = st.line
    let col = st.col
    var s = advance(st, 1)
    var buf = "$"
    while is_digit(peek(s, 0)) {
        buf = buf + peek(s, 0)
        s = advance(s, 1)
    }
    if peek(s, 0) == "." and is_digit(peek(s, 1)) {
        buf = buf + "."
        s = advance(s, 1)
        while is_digit(peek(s, 0)) {
            buf = buf + peek(s, 0)
            s = advance(s, 1)
        }
    }
    return make_result(make_tok("MONEY", buf, line, col), s)
}

fn decode_escape(e: Text) -> Text {
    if e == "n" { return "\n" }
    if e == "t" { return "\t" }
    if e == "r" { return "\r" }
    if e == "\"" { return "\"" }
    if e == "\\" { return "\\" }
    throw {code: "E001", message: "unknown escape '\\" + e + "'"}
    return ""
}

fn lex_string(st: Lx) -> LexResult {
    let line = st.line
    let col = st.col
    var s = advance(st, 1)
    var buf = ""
    var done = false
    while not done {
        if s.i >= len(s.src) {
            throw {code: "E001", message: "unterminated string"}
        }
        let ch = peek(s, 0)
        if ch == "\"" {
            s = advance(s, 1)
            done = true
        } else {
            if ch == "\n" {
                throw {code: "E001", message: "newline in single-line string; use \"\"\" \"\"\""}
            } else {
                if ch == "\\" {
                    s = advance(s, 1)
                    let e = peek(s, 0)
                    buf = buf + decode_escape(e)
                    s = advance(s, 1)
                } else {
                    buf = buf + ch
                    s = advance(s, 1)
                }
            }
        }
    }
    let t = make_tok("STRING", buf, line, col)
    return make_result(t, s)
}

fn lex_triple_string(st: Lx) -> LexResult {
    let line = st.line
    let col = st.col
    var s = advance(st, 3)
    var buf = ""
    var done = false
    while not done {
        if s.i >= len(s.src) {
            throw {code: "E001", message: "unterminated \"\"\" string"}
        }
        if peek(s, 0) == "\"" and peek(s, 1) == "\"" and peek(s, 2) == "\"" {
            s = advance(s, 3)
            done = true
        } else {
            if peek(s, 0) == "\\" {
                s = advance(s, 1)
                let e = peek(s, 0)
                // NB: unlike single-line strings, unknown escapes are
                // kept verbatim (mirrors the Python lexer).
                if e == "n" {
                    buf = buf + "\n"
                    s = advance(s, 1)
                } else {
                    if e == "t" {
                        buf = buf + "\t"
                        s = advance(s, 1)
                    } else {
                        if e == "r" {
                            buf = buf + "\r"
                            s = advance(s, 1)
                        } else {
                            if e == "\"" {
                                buf = buf + "\""
                                s = advance(s, 1)
                            } else {
                                if e == "\\" {
                                    buf = buf + "\\"
                                    s = advance(s, 1)
                                } else {
                                    buf = buf + "\\" + e
                                    s = advance(s, 1)
                                }
                            }
                        }
                    }
                }
            } else {
                buf = buf + peek(s, 0)
                s = advance(s, 1)
            }
        }
    }
    // strip one leading newline, common for block templates
    if len(buf) > 0 and buf[0] == "\n" {
        buf = str.slice(buf, 1, len(buf))
    }
    return make_result(make_tok("STRING", buf, line, col), s)
}

// -- main dispatch ----------------------------------------------------------

fn next_token(st: Lx) -> LexResult {
    let ch = peek(st, 0)
    let line = st.line
    let col = st.col

    if ch == "\"" {
        if peek(st, 1) == "\"" and peek(st, 2) == "\"" {
            return lex_triple_string(st)
        }
        return lex_string(st)
    }
    if ch == "$" and is_digit(peek(st, 1)) {
        return lex_money(st)
    }
    if is_digit(ch) {
        return lex_number(st)
    }
    if is_alpha(ch) or ch == "_" {
        return lex_ident(st)
    }
    if ch == "$" {
        throw {code: "E001", message: "'$' must be followed by a number (money literal)"}
    }

    let two = ch + peek(st, 1)
    if is_multi_op(two) {
        let ns = advance(st, 2)
        return make_result(make_tok(two, two, line, col), ns)
    }
    if is_symbol(ch) {
        if ch == "!" {
            throw {code: "E001", message: "unexpected '!'; did you mean '!=' or 'not'?"}
        }
        let ns = advance(st, 1)
        return make_result(make_tok(ch, ch, line, col), ns)
    }
    throw {code: "E001", message: "unexpected character '" + ch + "'"}
    return make_result(make_tok("EOF", "", line, col), st)
}

// -- entry point ---------------------------------------------------------------

fn lex(src: Text) -> [Tok] {
    var st: Lx = { src: src, i: 0, line: 1, col: 1 }
    var out: [Tok] = []
    var prev_kind = ""
    while st.i < len(st.src) {
        let ch = peek(st, 0)
        if ch == " " or ch == "\t" or ch == "\r" {
            st = advance(st, 1)
        } else {
            if ch == "\n" {
                st = advance(st, 1)
                if inserts_semi(prev_kind) {
                    let t: Tok = { kind: "SEMI", text: ";", line: st.line, col: st.col }
                    out = out + [t]
                    prev_kind = "SEMI"
                }
            } else {
                if ch == "/" and peek(st, 1) == "/" {
                    st = skip_line_comment(st)
                } else {
                    if ch == "/" and peek(st, 1) == "*" {
                        st = skip_block_comment(st)
                    } else {
                        let r = next_token(st)
                        out = out + [r.tok]
                        prev_kind = r.tok.kind
                        st = r.st
                    }
                }
            }
        }
    }
    let eof: Tok = { kind: "EOF", text: "", line: st.line, col: st.col }
    out = out + [eof]
    return out
}
