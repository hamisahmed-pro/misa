// Misa self-hosted parser (Phase 6a, second component).
//
// Mirrors impl/misa/parser.py exactly: recursive descent producing
// tagged-record AST nodes (see selfhost/AST.md for the format contract).
//
// Differences from the Python implementation (all documented):
// - The Misa lexer stores RAW lexeme text for numbers; INT/FLOAT/
//   DURATION/MONEY are converted here (int()/float()/parse_duration_ms/
//   /parse_money), mirroring the Python lexer's value computation.
// - `throw` only accepts {code, message}; source positions are encoded
//   into the message as "line:col\n" by err_msg().
// - Parser state is threaded explicitly as Px (functions cannot see
//   module-level vars).
// - leading_comments are not tracked (the Misa lexer does not produce
//   them).
// - Interpolated-string parts use StrPart nodes for literal text
//   (Python uses raw strings); both serialize identically.
//
// Entry point: parse(toks) -> Node  (a "Program" node)

import "lexer.misa"

// ---------------- cursor ----------------

// ---- generated: AST node types ----

type FieldPair {
    name: Text,
    value: Node
}

type StrTriple {
    a: Text,
    b: Text,
    c: Text
}

type Node {
    node: Text,
    line: Int,
    col: Int,
    name: Text,
    sval: Text,
    op: Text,
    ival: Int,
    fval: Float,
    bval: Bool,
    is_list: Bool,
    is_map: Bool,
    optional: Bool,
    has_tokens: Bool,
    tokens: Int,
    has_latency: Bool,
    latency_ms: Int,
    has_cost: Bool,
    cost_usd: Float,
    key_env: Text,
    model_file: Text,
    prov: Text,
    alias: Text,
    model_name: Text,
    event: Text,
    left: [Node],
    right: [Node],
    operand: [Node],
    obj: [Node],
    idx: [Node],
    target: [Node],
    value: [Node],
    ann: [Node],
    ret: [Node],
    budg: [Node],
    cond: [Node],
    iter: [Node],
    stm: [Node],
    handler: [Node],
    expr_body: [Node],
    call: [Node],
    expected: [Node],
    map_key: [Node],
    map_val: [Node],
    items: [Node],
    items2: [Node],
    pairs: [FieldPair],
    triples: [StrTriple],
    slist: [Text]
}

type Px {
    toks: [Tok],
    pos: Int
}

type PRes {
    node: Node,
    st: Px
}

type TRes {
    tok: Tok,
    st: Px
}

type PairsRes {
    pairs: [FieldPair],
    st: Px
}

type NodesRes {
    nodes: [Node],
    st: Px
}

fn field_pair(name: Text, value: Node) -> FieldPair {
    let p: FieldPair = { name: name, value: value }
    return p
}

fn str_triple(a: Text, b: Text, c: Text) -> StrTriple {
    let t: StrTriple = { a: a, b: b, c: c }
    return t
}

// ---- generated: node constructors ----

fn make_program(items: [Node], line: Int, col: Int) -> Node {
    let n: Node = { node: "Program", line: line, col: col, name: "", sval: "", op: "", ival: 0, fval: 0.0, bval: false, is_list: false, is_map: false, optional: false, has_tokens: false, tokens: 0, has_latency: false, latency_ms: 0, has_cost: false, cost_usd: 0.0, key_env: "", model_file: "", prov: "", alias: "", model_name: "", event: "", left: [], right: [], operand: [], obj: [], idx: [], target: [], value: [], ann: [], ret: [], budg: [], cond: [], iter: [], stm: [], handler: [], expr_body: [], call: [], expected: [], map_key: [], map_val: [], items: items, items2: [], pairs: [], triples: [], slist: [] }
    return n
}

