#!/usr/bin/env python3
"""misa - the Misa language toolchain (v0.3).

Usage:
  misa run <file.misa> [--mock mocks.json] [--json] [-- args...]
  misa debug [--agent] <file.misa> [--mock mocks.json] [-- args...]
  misa profile <file.misa> [--json] [--mock mocks.json] [--interval-ms N] [-- args...]
  misa repl
  misa check <file.misa> [--json]
  misa fmt <file.misa> [--write]
  misa test [path] [--mock mocks.json] [--json]
  misa build <file.misa> [-o output] [--emit-llvm file.ll] [--target triple] [--preload-file src@dst]... [--json]
  misa build --list-targets
  misa serve <file.misa> [--port PORT] [--key KEY] [--key-env VAR] [--base-url URL]
  misa lsp
  misa pkg <command> [...] [--registry URL] [--offline] [--json]
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                ".."))

from misa.parser import parse_source, ParseError
from misa.lexer import LexError
from misa.checker import Checker, check_file
from misa.fmt import Formatter
from misa.interp import Interpreter
from misa.loader import load as load_with_imports
from misa.errors import MisaError


def die(msg, code=1):
    sys.stderr.write(f"misa: error: {msg}\n")
    sys.exit(code)


def load_program(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError as e:
        die(f"cannot read {path}: {e}")


def load_mock(path):
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        die(f"cannot load mock file {path}: {e}")


def emit_errors(errors, as_json):
    if as_json:
        print(json.dumps(errors, indent=2))
    else:
        for e in errors:
            loc = f"{e['line']}:{e['col']}" \
                if e.get("line") else "<unknown>"
            sys.stderr.write(f"{loc}: {e['code']}: {e['message']}\n")
            if e.get("hint"):
                sys.stderr.write(f"  hint: {e['hint']}\n")


def emit_warnings(warnings, as_json):
    if as_json:
        return  # JSON mode embeds warnings in the payload; see cmd_check
    for w in warnings:
        loc = f"{w['line']}:{w['col']}" \
            if w.get("line") else "<unknown>"
        sys.stderr.write(f"{loc}: {w['code']}: {w['message']}\n")
        if w.get("hint"):
            sys.stderr.write(f"  hint: {w['hint']}\n")


def cmd_check(path, as_json, deny_warnings=False):
    # Phase 8 (overtake): keep the Checker so `misa check --json` can
    # also emit the throws graph (declared/inferred E-code sets per
    # function) alongside the diagnostics.
    merged, load_errors, _, file_of = load_with_imports(path)
    if merged is None:
        emit_errors(load_errors, as_json)
        return 1
    checker = Checker()
    errors = list(load_errors)
    errors.extend(checker.check(merged, file_of=file_of))
    warnings = checker.warnings
    if deny_warnings and warnings:
        # Phase 5d: `--deny-warnings` promotes warnings to errors.
        for w in warnings:
            errors.append({"code": w["code"],
                           "message": w["message"] + " (--deny-warnings)",
                           "line": w["line"], "col": w["col"],
                           "hint": w.get("hint", "")})
        warnings = []
    if errors:
        if as_json:
            print(json.dumps({"ok": False, "errors": errors,
                              "warnings": warnings,
                              "throws_graph": checker.throws_graph},
                             indent=2))
        else:
            emit_errors(errors, as_json)
        return 1
    if as_json:
        print(json.dumps({"ok": True, "errors": [], "warnings": warnings,
                          "throws_graph": checker.throws_graph}, indent=2))
    else:
        emit_warnings(warnings, as_json)
        print(f"{path}: OK")
    return 0


def cmd_fmt(path, write):
    src = load_program(path)
    try:
        out = Formatter().format_program(parse_source(src, path))
    except (ParseError, LexError) as e:
        die(f"{e.line}:{e.col}: {e}")
    if write:
        with open(path, "w", encoding="utf-8") as f:
            f.write(out)
    else:
        sys.stdout.write(out)
    return 0


def cmd_run(path, mock_path, as_json, prog_argv=None, use_bytecode=False,
            force_interp=False):
    mock_scripts = load_mock(mock_path)
    # Phase 1 JIT plan: AOT is the default execution tier. Try the
    # content-hashed AOT cache first; fall back to the interpreter when
    # the program is not AOT-coverable or the user forces --interp.
    if not use_bytecode and not force_interp:
        rc = _cmd_run_aot_cached(path, mock_path, as_json, prog_argv)
        if rc is not None:
            return rc
        # rc is None -> AOT rejected or failed; fall through to interp.
    merged, load_errors, _order, _file_of = load_with_imports(path)
    if merged is None:
        emit_errors(load_errors, as_json)
        return 1
    errors = load_errors + Checker().check(merged, file_of=_file_of)
    if errors:
        emit_errors(errors, as_json)
        return 1
    if use_bytecode:
        return cmd_run_bytecode(merged, mock_scripts, path, as_json,
                                prog_argv or [])
    interp = Interpreter(mock_scripts=mock_scripts,
                         main_dir=os.path.dirname(os.path.abspath(path)),
                         argv=prog_argv or [])
    interp.file_of = _file_of
    try:
        interp.run(merged)
    except MisaError as e:
        emit_errors([e.to_dict()], as_json)
        return 1
    return 0


def _cmd_run_aot_cached(path, mock_path, as_json, prog_argv):
    """Try running via the cached AOT binary.

    Returns the exit code when the AOT path handled the run, or None
    when the caller should fall back to the interpreter.
    """
    from misa.aot.build import build_cached
    from misa.aot.emit import AOTError
    try:
        status, payload = build_cached(path)
    except Exception as e:
        # Cache/build infrastructure failure: fall back, don't crash.
        if not as_json:
            print(f"# aot cache unavailable ({e}); using interpreter",
                  file=sys.stderr)
        return None
    if status == "hit" or status == "built":
        if not as_json and status == "built":
            print(f"# aot compiled -> {payload}", file=sys.stderr)
        return _exec_cached_binary(payload, prog_argv, mock_path)
    if status == "rejected":
        # Program uses features the AOT backend can't compile.
        if not as_json:
            e = payload
            code = getattr(e, "code", "E?")
            print(f"# aot rejected ({code}); using interpreter",
                  file=sys.stderr)
        return None
    # status == "error": frontend or toolchain errors -> report, no fallback
    # (falling back would hide real compile errors; but syntax errors
    # should still surface cleanly -- they do via emit_errors).
    errs = payload if isinstance(payload, list) else [payload]
    # If these are pure frontend errors, the interpreter would report
    # them identically; still, surface them directly.
    emit_errors([e if isinstance(e, dict) else
                 {"code": getattr(e, "code", "E600"),
                  "message": str(e), "line": 0, "col": 0}
                 for e in errs], as_json)
    return 1


def _exec_cached_binary(binpath, prog_argv, mock_path):
    """Exec the cached binary, forwarding argv. Returns exit code."""
    import subprocess
    cmd = [binpath] + (prog_argv or [])
    # NOTE: --mock is an interpreter feature; AOT binaries don't take it.
    # If a mock was requested with AOT, prefer the interpreter instead.
    # (Handled by the caller passing force_interp when mock_path is set.)
    try:
        r = subprocess.run(cmd)
        return r.returncode
    except OSError as e:
        print(f"# aot exec failed ({e}); using interpreter",
              file=sys.stderr)
        return None


def cmd_run_bytecode(merged, mock_scripts, path, as_json, prog_argv):
    """Run via bytecode compiler + C VM with auto-JIT.

    Falls back to the tree-walking interpreter when the program uses
    language features the bytecode compiler does not cover yet.

    Auto-JIT: hot BytecodeFunctions (call count >= threshold) that are
    int-only are compiled to native code via the LLVM JIT and executed
    directly on subsequent calls.
    """
    from misa.bytecode import (Compiler, BytecodeFunction, VM, RETURN,
                               LOAD_CONST)
    c = Compiler()
    try:
        for stmt in merged.items:
            c.compile(stmt)
        c.emit(LOAD_CONST, c.add_const(None))
        c.emit(RETURN)
    except NotImplementedError as e:
        # Feature not covered by the bytecode compiler: fall back.
        if not as_json:
            print(f"# bytecode: falling back to interpreter ({e})",
                  file=sys.stderr)
        interp = Interpreter(
            mock_scripts=mock_scripts,
            main_dir=os.path.dirname(os.path.abspath(path)),
            argv=prog_argv)
        try:
            interp.run(merged)
        except MisaError as err:
            emit_errors([err.to_dict()], as_json)
            return 1
        return 0
    # Prefer the MVal* VM (unified representation for JIT).
    # The .so files live in impl/misa/; ensure it's on sys.path.
    _misa_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "..", "misa")
    if _misa_dir not in sys.path:
        sys.path.insert(0, _misa_dir)
    try:
        import misa_vm_mval
        has_cvm_mval = True
    except ImportError:
        has_cvm_mval = False
    try:
        import misa_vm
        has_cvm = True
    except ImportError:
        has_cvm = False
    output = []

    # Auto-JIT state.
    from misa.jit import analyze_int_only, jit_compile_to_so, jit_load_and_run
    import ctypes
    import tempfile
    import threading
    JIT_THRESHOLD = 5
    jit_cache = {}  # BytecodeFunction -> (so_path, fn_name)
    jit_pending = set()  # BytecodeFunctions being compiled in background
    jit_threads = []  # Thread objects for joining at exit
    call_counts = {}
    rt_lib = None
    if has_cvm_mval:
        import misa_vm_mval as _mvm
        # Get the .so path for ctypes (for misa_int_val).
        import misa_vm_mval as _m
        _so = _m.__file__
        rt_lib = ctypes.CDLL(_so)
        rt_lib.misa_rt_init()
        rt_lib.misa_int_val.restype = ctypes.c_int64
        rt_lib.misa_int_val.argtypes = [ctypes.c_void_p]

    def _jit_compile_bg(func, so_path, as_json):
        """Background thread: compile func, update cache."""
        try:
            jit_compile_to_so(func, so_path, specialize_int=True)
            jit_cache[func] = (so_path, func.name)
            if not as_json:
                print(f"# jit: compiled {func.name} (background)",
                      file=sys.stderr)
        except Exception as e:
            if not as_json:
                print(f"# jit failed for {func.name}: {e}",
                      file=sys.stderr)
        finally:
            jit_pending.discard(func)

    def resolver(func, args):
        if isinstance(func, BytecodeFunction):
            # Hot-function detection for auto-JIT.
            if has_cvm_mval and rt_lib is not None:
                cnt = call_counts.get(func, 0) + 1
                call_counts[func] = cnt
                if func in jit_cache:
                    so_path, fn_name = jit_cache[func]
                    # Int-only: args are Python ints.
                    vars_vals = list(args) + [0] * (
                        len(func.varnames) - len(args))
                    consts_vals = list(func.consts)
                    try:
                        r_addr = jit_load_and_run(
                            so_path, fn_name, vars_vals, consts_vals,
                            specialize_int=True)
                        if r_addr is None:
                            # Deopt: JIT hit a runtime error; fall back to VM.
                            # Invalidate the cache entry to avoid repeat.
                            if not as_json:
                                print(f"# jit: deopt {func.name}, "
                                      f"falling back to VM", file=sys.stderr)
                            del jit_cache[func]
                        else:
                            return rt_lib.misa_int_val(r_addr)
                    except Exception:
                        pass  # fall through to VM
                elif cnt >= JIT_THRESHOLD:
                    try:
                        if analyze_int_only(func):
                            from misa.jit import jit_cache_path
                            so_path = jit_cache_path(func)
                            if os.path.isfile(so_path):
                                # Cache hit: use immediately.
                                jit_cache[func] = (so_path, func.name)
                                if not as_json:
                                    print(f"# jit: cache hit {func.name}",
                                          file=sys.stderr)
                                return resolver(func, args)
                            elif func not in jit_pending:
                                # Cache miss: compile in background,
                                # continue with VM meanwhile.
                                jit_pending.add(func)
                                t = threading.Thread(
                                    target=_jit_compile_bg,
                                    args=(func, so_path, as_json),
                                    daemon=False)  # non-daemon: join at exit
                                jit_threads.append(t)
                                t.start()
                                if not as_json:
                                    print(f"# jit: compiling {func.name} "
                                          f"in background", file=sys.stderr)
                    except Exception as e:
                        if not as_json:
                            print(f"# jit failed for {func.name}: {e}",
                                  file=sys.stderr)
                        pass
            # VM execution.
            if has_cvm_mval:
                return misa_vm_mval.run(func.code, func.consts,
                                        len(func.varnames), args, resolver,
                                        output)
            if has_cvm:
                return misa_vm.run(func.code, func.consts,
                                   len(func.varnames), args, resolver,
                                   output)
            return VM().run(func, list(args))
        return func(*args)

    try:
        if has_cvm_mval:
            misa_vm_mval.run(c.code, c.consts, len(c.varnames), (), resolver,
                             output)
        elif has_cvm:
            misa_vm.run(c.code, c.consts, len(c.varnames), (), resolver,
                        output)
        else:
            VM().run(BytecodeFunction('<main>', c.code, c.consts,
                                      c.varnames, 0))
    except MisaError as e:
        emit_errors([e.to_dict()], as_json)
        return 1
    except RuntimeError as e:
        emit_errors([{"code": "E300", "message": str(e), "line": 0,
                      "col": 0}], as_json)
        return 1
    # Wait for background JIT compilations to finish so the cache is
    # populated for the next run.
    for t in jit_threads:
        t.join(timeout=30)
    return 0



def cmd_debug(path, mock_path, agent, prog_argv=None):
    from misa.debugger import debug_file
    return debug_file(path, mock_path, agent, prog_argv)


def cmd_profile(path, mock_path, as_json, interval_ms, prog_argv=None):
    from misa.profiler import profile_file
    return profile_file(path, mock_path, as_json, interval_ms, prog_argv)


def cmd_repl():
    from misa.repl import repl_loop
    return repl_loop()


def discover_test_files(path):
    """Test discovery for `misa test [path]`: a file path runs that file;
    a directory is walked for `*_test.misa` / `test_*.misa` files."""
    if os.path.isfile(path):
        return [path]
    found = []
    for dirpath, dirnames, filenames in os.walk(path):
        dirnames[:] = [d for d in dirnames
                       if d not in ("__pycache__", "node_modules", ".git",
                                    "target")]
        for fn in sorted(filenames):
            if fn.endswith("_test.misa") or (
                    fn.startswith("test_") and fn.endswith(".misa")):
                found.append(os.path.join(dirpath, fn))
    return sorted(found)


def run_test_file(path, mock_scripts):
    """Run one test file: unit `test` blocks (fresh interpreter per test
    for isolation) plus model `eval` blocks (existing behavior).
    Returns a list of result dicts:
      {"kind": "test"|"eval"|"file", "name", "file", "line",
       "pass": bool, "message": str}"""
    from misa import ast as _ast
    results = []
    merged, load_errors, _order, _file_of = load_with_imports(path)
    if merged is None:
        results.append({"kind": "file", "name": path, "file": path,
                        "line": 0, "pass": False,
                        "message": "; ".join(load_errors)})
        return results
    errors = load_errors + Checker().check(merged, file_of=_file_of)
    if errors:
        msg = "; ".join(
            f"{e.get('line', 0)}:{e.get('col', 0)}: "
            f"{e.get('code')}: {e.get('message')}" for e in errors)
        results.append({"kind": "file", "name": path, "file": path,
                        "line": 0, "pass": False,
                        "message": "check failed: " + msg})
        return results
    # Unit tests: one fresh interpreter per test — a failing test (or a
    # test that corrupts global state) can never kill the rest of the run.
    for item in merged.items:
        if not isinstance(item, _ast.TestDecl):
            continue
        tfile = _file_of.get(id(item), path)
        interp = Interpreter(
            mock_scripts=mock_scripts,
            main_dir=os.path.dirname(os.path.abspath(path)))
        interp.file_of = _file_of
        try:
            interp.load(merged)
            interp.exec_setup(merged)
            interp.run_one_test(item)
        except MisaError as e:
            results.append({"kind": "test", "name": item.name,
                            "file": tfile, "line": item.line,
                            "pass": False,
                            "message": f"{e.code}: {e.message}"})
        else:
            results.append({"kind": "test", "name": item.name,
                            "file": tfile, "line": item.line,
                            "pass": True, "message": ""})
    # Model evals (pre-existing `misa test` behavior, unchanged).
    if any(isinstance(item, _ast.EvalDecl) for item in merged.items):
        interp = Interpreter(
            mock_scripts=mock_scripts,
            main_dir=os.path.dirname(os.path.abspath(path)))
        interp.file_of = _file_of
        interp.load(merged)
        for name, edecl in interp.evals.items():
            efile = _file_of.get(id(edecl), path)
            mdecl = interp.models[edecl.model_name]
            given = {k: v for k, v in edecl.given}
            ok_all = True
            first_err = ""
            for run in range(edecl.runs):
                try:
                    arg_values = []
                    for pn, _ in mdecl.params:
                        node = given[pn]
                        arg_values.append(
                            interp.eval_expr(node, interp.global_env))
                    result = interp.call_model(mdecl, arg_values, edecl)
                    env = __import__(
                        "misa.interp", fromlist=["Env"]).Env(
                            interp.global_env)
                    env.define("result", result, False)
                    for pn, _ in mdecl.params:
                        env.define(pn, arg_values[
                            [p for p, _ in mdecl.params].index(pn)], False)
                    passed = interp.truthy(
                        interp.eval_expr(edecl.expect, env))
                    if not passed:
                        ok_all = False
                        if not first_err:
                            first_err = "expect was false"
                except MisaError as e:
                    ok_all = False
                    if not first_err:
                        first_err = f"{e.code}: {e.message}"
            results.append({"kind": "eval", "name": name, "file": efile,
                            "line": edecl.line, "pass": ok_all,
                            "message": first_err})
    return results


def cmd_test(path, mock_path, as_json):
    mock_scripts = load_mock(mock_path)
    files = discover_test_files(path)
    if not files:
        if os.path.isfile(path):
            files = [path]
        else:
            sys.stderr.write(
                f"misa test: no test files found under '{path}'\n")
            return 1
    results = []
    for f in files:
        results.extend(run_test_file(f, mock_scripts))
    failed = [r for r in results if not r["pass"]]
    if as_json:
        print(json.dumps(results, indent=2))
    else:
        for r in results:
            loc = f"{r['file']}:{r['line']}" if r["line"] else r["file"]
            if r["kind"] == "test":
                if r["pass"]:
                    print(f"PASS  {r['name']}  ({loc})")
                else:
                    print(f"FAIL  {r['name']}  ({loc}): {r['message']}")
            elif r["kind"] == "eval":
                status = "PASS" if r["pass"] else "FAIL"
                print(f"{status}  eval {r['name']}  ({loc})"
                      + (f": {r['message']}" if r["message"] else ""))
            else:
                print(f"ERROR {loc}: {r['message']}")
        n_test = sum(1 for r in results if r["kind"] == "test")
        n_tpass = sum(1 for r in results
                      if r["kind"] == "test" and r["pass"])
        n_eval = sum(1 for r in results if r["kind"] == "eval")
        n_epass = sum(1 for r in results
                      if r["kind"] == "eval" and r["pass"])
        parts = []
        if n_test:
            parts.append(f"{n_tpass}/{n_test} tests passed")
        if n_eval:
            parts.append(f"{n_epass}/{n_eval} evals passed")
        if parts:
            print(f"\n{', '.join(parts)}")
        elif failed:
            print(f"\n{len(failed)} file(s) failed")
        else:
            print("\nno tests found")
    return 1 if failed else 0



def cmd_build(path, out, emit_llvm, target, as_json, preload_files):
    from misa.aot.build import build, canonical_target, host_triple
    from misa.aot.emit import AOTError
    if not out:
        base = os.path.basename(path)
        stem = base[:-5] if base.endswith(".misa") else base
        if target and canonical_target(target) != host_triple():
            # cross targets: object file, except emscripten (M3) which
            # links to misa.js + misa.wasm.
            if canonical_target(target) == "wasm32-unknown-emscripten":
                out = stem + ".js"
            else:
                out = stem + ".o"
        elif base.endswith(".misa"):
            out = base[:-5]
        else:
            out = base + ".bin"
    try:
        ok, errors = build(path, out, emit_llvm=emit_llvm or "",
                           target=target or "",
                           preload_files=preload_files)
    except AOTError as e:
        # C-2: surface the E-code (was a raw die() string).
        die(f"{e.code}: {e.message}")
    except RuntimeError as e:
        # H-6: toolchain failures are E600, never a bare message.
        die(f"E600: {e}")
    if not ok:
        emit_errors(errors, as_json)
        return 1
    if not as_json:
        print(f"built {out}")
    return 0


def cmd_list_targets():
    from misa.aot.build import list_targets
    rows = list_targets()
    w = max(len(t) for t, _, _, _ in rows)
    print(f"{'triple'.ljust(w)}  status (C compiler | entry)")
    for triple, status, cc, entry in rows:
        print(f"{triple.ljust(w)}  {status} ({cc} | {entry})")
    return 0


def cmd_benchmark(args):
    """Canonical `misa benchmark` command.

    Runs the Benchmarks Game suite (Misa AOT vs Python3), emits JSON
    as the source of truth. Markdown/CSV are derived from JSON, never
    hand-typed. (Implements the Benchmark Review Plan recommendation
    for a canonical benchmark command.)
    """
    from misa.benchmark import main as bench_main
    return bench_main(args)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd = argv[1]
    args = argv[2:]
    as_json = "--json" in args
    # `misa pkg` parses --json itself (per-command and global flag);
    # stripping it here would lose the flag before pkg sees it.
    if cmd != "pkg":
        args = [a for a in args if a != "--json"]
    if cmd == "check" and len(args) >= 1:
        deny_warnings = "--deny-warnings" in args
        args = [a for a in args if a != "--deny-warnings"]
        if len(args) == 1:
            return cmd_check(args[0], as_json, deny_warnings)
        die("usage: misa check <file.misa> [--json] [--deny-warnings]")
    if cmd == "fmt" and 1 <= len(args) <= 2:
        return cmd_fmt(args[0], "--write" in args)
    if cmd == "run" and len(args) >= 1:
        # Program argv: everything after `--` goes to the program's
        # argv(), not to misa itself.
        if "--" in args:
            i = args.index("--")
            prog_argv, args = args[i + 1:], args[:i]
        else:
            prog_argv = []
        mock = None
        rest = []
        use_bytecode = False
        force_interp = False
        i = 0
        while i < len(args):
            if args[i] == "--mock" and i + 1 < len(args):
                mock = args[i + 1]
                i += 2
            elif args[i] == "--bytecode":
                use_bytecode = True
                i += 1
            elif args[i] == "--interp":
                force_interp = True
                i += 1
            else:
                rest.append(args[i])
                i += 1
        if len(rest) != 1:
            die("usage: misa run <file.misa> [--mock mocks.json] "
                "[--bytecode] [--interp] [-- args...]")
        # --mock is an interpreter feature; force the interpreter tier.
        if mock is not None:
            force_interp = True
        return cmd_run(rest[0], mock, as_json, prog_argv,
                       use_bytecode=use_bytecode, force_interp=force_interp)
    if cmd == "test":
        mock = None
        rest = []
        i = 0
        while i < len(args):
            if args[i] == "--mock" and i + 1 < len(args):
                mock = args[i + 1]
                i += 2
            else:
                rest.append(args[i])
                i += 1
        if len(rest) > 1:
            die("usage: misa test [path] [--mock mocks.json] [--json]")
        return cmd_test(rest[0] if rest else ".", mock, as_json)
    if cmd == "benchmark":
        return cmd_benchmark(args)
    if cmd == "build" and 1 <= len(args) <= 12:
        if "--list-targets" in args:
            return cmd_list_targets()
        out = None
        emit_llvm = ""
        target = ""
        preload_files = []
        rest = []
        i = 0
        while i < len(args):
            if args[i] == "-o" and i + 1 < len(args):
                out = args[i + 1]
                i += 2
            elif args[i] == "--emit-llvm" and i + 1 < len(args):
                emit_llvm = args[i + 1]
                i += 2
            elif args[i] == "--target" and i + 1 < len(args):
                target = args[i + 1]
                i += 2
            elif args[i] == "--preload-file" and i + 1 < len(args):
                # web target (M3): bundle a host file into the virtual
                # FS, as src or src@dst.
                preload_files.append(args[i + 1])
                i += 2
            else:
                rest.append(args[i])
                i += 1
        if len(rest) != 1:
            die(f"usage: misa build <file.misa> [-o output] "
                f"[--emit-llvm file.ll] [--target triple] "
                f"[--preload-file src@dst]")
        return cmd_build(rest[0], out, emit_llvm, target, as_json,
                         preload_files)
    if cmd == "debug" and 1 <= len(args) <= 4:
        agent = "--agent" in args
        if "--" in args:
            i = args.index("--")
            prog_argv, args = args[i + 1:], args[:i]
        else:
            prog_argv = []
        mock = None
        rest = []
        i = 0
        while i < len(args):
            if args[i] == "--mock" and i + 1 < len(args):
                mock = args[i + 1]
                i += 2
            elif args[i] == "--agent":
                i += 1
            else:
                rest.append(args[i])
                i += 1
        if len(rest) != 1:
            die("usage: misa debug [--agent] <file.misa> "
                "[--mock mocks.json] [-- args...]")
        return cmd_debug(rest[0], mock, agent, prog_argv)
    if cmd == "profile" and 1 <= len(args) <= 6:
        if "--" in args:
            i = args.index("--")
            prog_argv, args = args[i + 1:], args[:i]
        else:
            prog_argv = []
        mock = None
        interval_ms = 10.0
        rest = []
        i = 0
        while i < len(args):
            if args[i] == "--mock" and i + 1 < len(args):
                mock = args[i + 1]
                i += 2
            elif args[i] == "--interval-ms" and i + 1 < len(args):
                try:
                    interval_ms = float(args[i + 1])
                except ValueError:
                    die("--interval-ms needs a number of milliseconds")
                if interval_ms <= 0:
                    die("--interval-ms must be positive")
                i += 2
            else:
                rest.append(args[i])
                i += 1
        if len(rest) != 1:
            die("usage: misa profile <file.misa> [--json] "
                "[--mock mocks.json] [--interval-ms N] [-- args...]")
        return cmd_profile(rest[0], mock, as_json, interval_ms, prog_argv)
    if cmd == "repl" and len(args) == 0:
        return cmd_repl()
    if cmd == "serve" and 1 <= len(args) <= 9:
        from misa.serve import cmd_serve
        return cmd_serve(args)
    if cmd == "lsp" and len(args) == 0:
        from misa.lsp import main as lsp_main
        return lsp_main()
    if cmd == "pkg":
        from misa.pkg import cmd_pkg
        return cmd_pkg(args)
    die(f"unknown command: {' '.join(argv[1:])}\n{__doc__}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
