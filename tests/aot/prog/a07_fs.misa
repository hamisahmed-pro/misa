let p = "/tmp/aot_fs_test.txt"
fs.write(p, "hello\nworld\n")
let t = fs.read(p)
print(t)
print(len(t))

try {
    fs.read("/tmp/aot_no_such_file_xyz.txt")
    print("bad")
} catch e {
    print("read {e.code}")
}

try {
    fs.write("/tmp/no_such_dir_xyz/f.txt", "x")
    print("bad")
} catch e {
    print("write {e.code}")
}
print("fs-ok")
