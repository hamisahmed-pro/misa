// Phase 5a: first-class functions — AOT parity.
fn double(x: Int) -> Int {
  return x * 2
}

fn apply(f: (Int) -> Int, v: Int) -> Int {
  return f(v)
}

fn make_adder(n: Int) -> (Int) -> Int {
  return |x: Int| x + n
}

fn compose(f: (Int) -> Int, g: (Int) -> Int) -> (Int) -> Int {
  return |x: Int| f(g(x))
}

fn map2(xs: [Int], f: (Int) -> Int) -> [Int] {
  var out: [Int] = []
  for x in xs {
    out = out + [f(x)]
  }
  return out
}

let g = double
print(g(21))
print(apply(double, 5))
print(apply(|x: Int| x + 1, 10))
let h: (Int) -> Int = |x| x * 3
print(h(7))

let add5 = make_adder(5)
print(add5(10))
print(make_adder(100)(23))

var count = 0
let inc = || {
  count = count + 1
  return count
}
print(inc())
print(inc())
count = 10
print(inc())
print(count)

print(map2([1, 2, 3], |x: Int| x * 2))
let f = compose(|x: Int| x + 1, |x: Int| x * 10)
print(f(5))
print(g)
