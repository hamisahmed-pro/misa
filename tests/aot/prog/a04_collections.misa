var xs = [3, 1, 2]
print(xs)
print(xs[0])
print(xs[2])
print(xs[-1])
xs[1] = 99
print(xs)
print(len(xs))

var m = {"b": 2, "a": 1}
print(m)
print(m["a"])
m["c"] = 3
print(m["c"])
print(len(m))

var r = {name: "ada", age: 30, tags: ["x", "y"]}
print(r)
print(r.name)
r.age = 31
print(r.age)

let nested = {a: [1, {b: 2}], c: "deep"}
print(nested)
print(nested.a[1].b)
print(nested.a[0])

var im = {"one": 1}
im[1] = "one-int"
im[2] = "two-int"
print(im[1])
print(im[2])

print([1, 2] == [1, 2])
print([1, 2] == [1, 3])
print({a: 1} == {a: 1})

fn word_count(text: Text) -> Map<Text, Int> {
    var counts: Map<Text, Int> = {}
    counts["the"] = 2
    return counts
}

let wc = word_count("x")
print(wc["the"])
print(len(wc))
