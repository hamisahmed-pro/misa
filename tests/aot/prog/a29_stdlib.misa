// a29: Wave 3 stdlib — regex, crypto, random, time, temp files,
// collections, Set<T>, str extras. AOT/interp parity.
let email = regex("([A-Za-z0-9_]+)@([A-Za-z0-9_]+)\\.([a-z]+)")
print(regex.matches(email, "user@example.com"))
print(regex.matches(email, "nope"))
print(regex.captures(email, "user@example.com"))
print(regex.find(email, "mail user@example.com!"))
print(regex.find_all(regex("[0-9]+"), "a1 b22 c333"))
print(regex.replace(regex("[0-9]+"), "a1 b22", "#"))
print(regex.replace(regex("([a-z]+)@([a-z]+)"), "x@yy", "$2@$1"))
// backtracking: alternation + nested quantifiers (PCRE semantics)
print(regex.matches(regex("a|ab"), "ab"))
print(regex.matches(regex("(a|ab)*"), "abab"))
print(regex.find(regex("(a|ab)c"), "abc"))
print(regex.matches(regex("(a|b)*abb"), "aababb"))
print(regex.find_all(regex("a*"), "baa"))
print(regex.matches(regex("[^0-9]+"), "abc"))
print(regex.matches(regex("h.llo"), "héllo"))
print(crypto.sha256("hello"))
print(crypto.sha1("hello"))
print(crypto.md5("hello"))
print(crypto.hmac_sha256("key", "The quick brown fox jumps over the lazy dog"))
// random: determinism within a backend (seed twice -> same stream)
random.seed(1234)
let r1 = random.int(1, 1000)
let f1 = random.float()
random.seed(1234)
print(random.int(1, 1000) == r1)
print(random.float() == f1)
print(random.choice([9]))
let sh = random.shuffle([1, 2, 3, 4, 5])
print(len(sh) == 5)
let t = time.from_parts(2026, 10, 7, 12, 0, 0)
print(time.weekday(t))
print(time.add(t, 60) - t)
print(time.add_hours(t, 3) - t)
print(time.in_tz(t, 2) - t)
print(time.is_leap(2024))
print(time.is_leap(1900))
print(len(fs.temp_file()) > 4)
print(len(fs.temp_dir()) > 4)
print(map([1, 2, 3], |x| x * 10))
print(filter([1, 2, 3, 4, 5], |x| x % 2 == 1))
print(fold([1, 2, 3], 100, |a, b| a - b))
print(sort_by([3, 1, 2], |a, b| a < b))
print(list.flat([[1], [2, 3], []]))
print(list.zip([1, 2], ["a", "b", "c"]))
print(list.unique([2, 1, 2, 3, 1]))
let s = set()
s.add(1)
s.add(2)
s.add(1)
print(set.len(s))
print(set.contains(s, 2))
s.remove(1)
print(set.to_list(s))
print(str.join(["a", "b"], "-"))
print(str.replace("aaa", "aa", "b"))
print(str.to_upper("abc"))
print(str.to_lower("ABC"))
print(str.ends_with("hello", "lo"))
print(str.pad_left("7", 3, "0"))
print(str.pad_right("7", 3, "0"))
print(s)
print(email)
