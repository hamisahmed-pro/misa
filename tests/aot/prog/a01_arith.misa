fn fact(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn noop() {
    print("void-ok")
}

print(fact(10))
print(fib(20))
print(7 / 2)
print(10 / 4)
print(-7 % 3)
print(7 % -3)
print(-7.5 % 3.0)
print(2 + 3 * 4 - 1)
print((2 + 3) * 4)
print(1 == 1.0)
print(1 != 2)
print("abc" < "abd")
print("abc" == "abc")
noop()
print(-(3 + 4))
print(not false)
