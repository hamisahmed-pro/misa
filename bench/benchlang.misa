// Misa adapter for benchLANG's five fixed workloads.
// Inputs/checksums intentionally mirror GlebOlsen/benchLANG at commit
// 2731f29bcf0bfda750a62c81337b5e5e7456bb4a.
// This file is benchmark infrastructure, not a language feature demo.

var PRIMES_LIMIT = 20000000
var FIBONACCI_N = 45
var STRING_ITER = 5000000
var MANDEL_SIZE = 4096
var MANDEL_MAX_ITER = 256
var TREE_MIN_DEPTH = 4
var TREE_MAX_DEPTH = 18

type Node {
  left: Node?,
  right: Node?,
  item: Int
}

fn is_prime(n: Int) -> Bool {
  if n < 2 { return false }
  if n < 4 { return true }
  if n % 2 == 0 or n % 3 == 0 { return false }
  var i = 5
  while i * i <= n {
    if n % i == 0 or n % (i + 2) == 0 { return false }
    i = i + 6
  }
  return true
}

fn bench_primes(limit: Int) -> Int {
  var count = 0
  var i = 2
  while i < limit {
    if is_prime(i) { count = count + 1 }
    i = i + 1
  }
  return count
}

fn fib(n: Int) -> Int {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}

fn bench_strings(sentence: Text, iters: Int) -> Int {
  let words = str.split(sentence, " ")
  var total = 0
  var it = 0
  while it < iters {
    var a = 0
    while a < len(words) {
      var b = 0
      while b < len(words) {
        if words[a] == words[b] { total = total + 1 }
        b = b + 1
      }
      a = a + 1
    }
    it = it + 1
  }
  return total
}

fn bench_mandelbrot(size: Int) -> Int {
  var checksum = 0
  var py = 0
  while py < size {
    let cy = py / size * 3.0 - 1.5
    var px = 0
    while px < size {
      let cx = px / size * 3.0 - 2.0
      var zx = 0.0
      var zy = 0.0
      var iter = 0
      while iter < MANDEL_MAX_ITER and zx * zx + zy * zy <= 4.0 {
        let nx = zx * zx - zy * zy + cx
        zy = 2.0 * zx * zy + cy
        zx = nx
        iter = iter + 1
      }
      checksum = checksum + iter
      px = px + 1
    }
    py = py + 1
  }
  return checksum
}

fn make_tree(item: Int, depth: Int) -> Node {
  if depth == 0 {
    return {left: nil, right: nil, item: item}
  }
  return {
    left: make_tree(2 * item - 1, depth - 1),
    right: make_tree(2 * item, depth - 1),
    item: item
  }
}

fn check_tree(n: Node) -> Int {
  if n.left == nil {
    return n.item
  }
  return n.item + check_tree(n.left) - check_tree(n.right)
}

fn bench_binary_trees(max_depth: Int) -> Int {
  var checksum = 0
  let stretch = make_tree(0, max_depth + 1)
  checksum = checksum + check_tree(stretch)
  let long_lived = make_tree(0, max_depth)

  var d = TREE_MIN_DEPTH
  while d <= max_depth {
    let iters = 1 << (max_depth - d + TREE_MIN_DEPTH)
    var i = 0
    while i < iters {
      checksum = checksum + check_tree(make_tree(i + 1, d))
      i = i + 1
    }
    d = d + 2
  }

  checksum = checksum + check_tree(long_lived)
  return checksum
}

fn main() throws E300 {
  let args = argv()
  var bench = "all"
  if len(args) > 1 { bench = args[1] }

  let sentence = "The quick brown fox jumps over dat lazy dog that was not enough to jump over the frog again"

  if bench == "primes" {
    print(bench_primes(PRIMES_LIMIT))
  } else if bench == "fib" {
    print(fib(FIBONACCI_N))
  } else if bench == "strings" {
    print(bench_strings(sentence, STRING_ITER))
  } else if bench == "mandelbrot" {
    print(bench_mandelbrot(MANDEL_SIZE))
  } else if bench == "binarytrees" {
    print(bench_binary_trees(TREE_MAX_DEPTH))
  } else {
    print(bench_primes(PRIMES_LIMIT))
    print(fib(FIBONACCI_N))
    print(bench_strings(sentence, STRING_ITER))
    print(bench_mandelbrot(MANDEL_SIZE))
    print(bench_binary_trees(TREE_MAX_DEPTH))
  }
}

main()
