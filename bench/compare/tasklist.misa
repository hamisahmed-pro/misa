// Task list screen — head-to-head comparison artifact (Misa side).
// Same app as the React version: a task list with an add box.
// State lives in SQLite (the supported AOT screen pattern): the Add
// handler writes to the db and re-navigates to refresh.
app TaskList {
    title: "TaskList",
    version: "0.1.0",
}

table tasks {
    id: Int @primary,
    title: Text,
}

fn task_titles() -> [Text] {
    let dbh = db.open("tasks.db")
    db.exec(dbh, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT)")
    let rows = db.query(dbh, "SELECT title FROM tasks ORDER BY id")
    var out: [Text] = []
    for r in rows {
        out = out + [r.title]
    }
    db.close(dbh)
    return out
}

screen Tasks() {
    Column {
        Heading(text: "My Tasks")
        List(items: task_titles())
        TextInput(id: newTask, hint: "New task")
        Button(label: "Add", onTap: || {
            if newTask.text != "" {
                let dbh = db.open("tasks.db")
                db.exec(dbh, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT)")
                db.exec(dbh, "INSERT INTO tasks (title) VALUES (?)", [newTask.text])
                db.close(dbh)
            }
            navigate(Tasks())
        })
    }
}

navigate(Tasks())
