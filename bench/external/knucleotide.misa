// knucleotide — Misa port (using list of pairs instead of Map)
// Counts 3-mers in DNA sequence. Uses linear search (64 max distinct).

fn find_idx(pairs: [[Text]], kmer: Text) -> Int throws E300 {
  var i = 0
  while i < len(pairs) {
    if pairs[i][0] == kmer {
      return i
    }
    i = i + 1
  }
  return -1
}

fn main() throws E300 {
  var n = 10000
  let args = argv()
  if len(args) > 1 {
    n = int(args[1])
  }
  // Use builder explicitly to avoid auto-transformation issues with indexing
  let b = builder()
  let bases = ["a", "c", "g", "t"]
  var i = 0
  while i < n {
    b.append(bases[i % 4])
    i = i + 1
  }
  let seq = b.build()
  // Count 3-mers using list of [kmer, count] pairs
  var pairs: [[Text]] = []
  // Actually need [Text, Int] pairs — use parallel lists
  var keys: [Text] = []
  var vals: [Int] = []
  i = 0
  while i < n - 3 {
    let kmer = seq[i] + seq[i+1] + seq[i+2]
    var found = -1
    var j = 0
    while j < len(keys) {
      if keys[j] == kmer {
        found = j
      }
      j = j + 1
    }
    if found >= 0 {
      vals[found] = vals[found] + 1
    } else {
      keys = keys + [kmer]
      vals = vals + [1]
    }
    i = i + 1
  }
  print(len(keys))
}

main()
