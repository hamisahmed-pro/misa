// reverse-complement — Misa port
// Reverses DNA sequence and complements bases.

fn complement(c: Text) -> Text {
  if c == "a" { return "t" }
  if c == "t" { return "a" }
  if c == "c" { return "g" }
  if c == "g" { return "c" }
  if c == "A" { return "T" }
  if c == "T" { return "A" }
  if c == "C" { return "G" }
  if c == "G" { return "C" }
  return c
}

fn main() throws E300 {
  var n = 10000
  let args = argv()
  if len(args) > 1 {
    n = int(args[1])
  }
  // Generate test sequence
  var seq = ""
  let bases = ["a", "c", "g", "t"]
  var i = 0
  while i < n {
    seq = seq + bases[i % 4]
    i = i + 1
  }
  // Reverse complement
  var result = ""
  i = len(seq) - 1
  while i >= 0 {
    result = result + complement(seq[i])
    i = i - 1
  }
  print(len(result))
}

main()
