// mandelbrot — Misa port (single-threaded computational equivalent)
// Benchmarks Game mandelbrot does N×N pixel calculations.
// This version computes the same workload, outputs checksum.

fn mandelbrot(n: Int) -> Int throws E300 {
  var sum = 0
  var y = 0
  while y < n {
    let ci = 2.0 * y / n - 1.0
    var x = 0
    while x < n {
      let cr = 2.0 * x / n - 1.5
      var zr = 0.0
      var zi = 0.0
      var iter = 0
      var inside = true
      while iter < 50 and inside {
        let zr2 = zr * zr
        let zi2 = zi * zi
        if zr2 + zi2 > 4.0 {
          inside = false
        } else {
          zi = 2.0 * zr * zi + ci
          zr = zr2 - zi2 + cr
          iter = iter + 1
        }
      }
      if inside {
        sum = sum + 1
      }
      x = x + 1
    }
    y = y + 1
  }
  return sum
}

fn main() throws E300 {
  var n = 500
  let args = argv()
  if len(args) > 1 {
    n = int(args[1])
  }
  let result = mandelbrot(n)
  print(result)
}

main()
