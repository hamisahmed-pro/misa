table tasks {
  id: Int @primary,
  title: Text,
  status: Text,
  created: Text,
}

fn getenv(name: Text, dflt: Text) -> Text {
    var out = dflt
    try {
        out = env(name)
    } catch e {
        out = dflt
    }
    return out
}

fn fail(msg: Text) {
    print(msg)
    throw { code: "EUSER", message: msg }
}

fn is_digits(s: Text) -> Bool {
    if len(s) == 0 {
        return false
    }
    var i = 0
    while i < len(s) {
        let o = str.ord(str.slice(s, i, i + 1))
        if o < 48 or o > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn usage() {
    print("taskman - a small CLI task manager")
    print("Set TASKMAN_CMD to one of: add, list, doing, done, delete, export, import, help")
    print("TASKMAN_ARG carries the title, id, or file path. TASKMAN_DB selects the database.")
    print("  add <title>    add a new task")
    print("  list           list all tasks")
    print("  doing <id>     mark a task as doing")
    print("  done <id>      mark a task as done")
    print("  delete <id>    delete a task")
    print("  export <path>  export tasks to a JSON file")
    print("  import <path>  import tasks from a JSON file")
    print("  help           show this help")
}

fn now_iso() -> Text {
    let fmt = "%Y-%m-%dT%H:%M:%SZ"
    return time.format(time.now(), fmt)
}

fn do_mark(db: Db, arg: Text, st: Text) {
    if not is_digits(arg) {
        fail("Error: bad id '{arg}'")
    }
    let q = "SELECT id FROM tasks WHERE id = " + arg
    let rows = db.query(db, q)
    if len(rows) == 0 {
        fail("Error: no task #{arg}")
    }
    let u = "UPDATE tasks SET status = ? WHERE id = " + arg
    db.exec(db, u, [st])
    print("Marked #{arg} as {st}")
}

fn do_delete(db: Db, arg: Text) {
    if not is_digits(arg) {
        fail("Error: bad id '{arg}'")
    }
    let q = "SELECT id FROM tasks WHERE id = " + arg
    let rows = db.query(db, q)
    if len(rows) == 0 {
        fail("Error: no task #{arg}")
    }
    let d = "DELETE FROM tasks WHERE id = " + arg
    db.exec(db, d)
    print("Deleted #{arg}")
}

fn do_export(db: Db, arg: Text) {
    if arg == "" {
        fail("Error: file required")
    }
    let rows = db.query(db, "SELECT id, title, status, created FROM tasks ORDER BY id")
    let n = len(rows)
    let js = json.stringify(rows)
    fs.write(arg, js)
    print("Exported {n} tasks to {arg}")
}

fn do_import(db: Db, arg: Text) {
    var text = ""
    try {
        text = fs.read(arg)
    } catch e {
        fail("Error: cannot read {arg}")
    }
    var val = nil
    try {
        val = json.parse(text)
    } catch e {
        fail("Error: bad JSON in {arg}")
    }
    let flat = json.stringify(val)
    if not str.starts_with(flat, "[") {
        fail("Error: bad JSON in {arg}")
    }
    var count = 0
    for item in val {
        var title = ""
        var st = "todo"
        try {
            let t: Text = item["title"]
            title = t
            try {
                let s: Text = item["status"]
                st = s
            } catch e2 {
                st = "todo"
            }
        } catch e {
            fail("Error: bad JSON in {arg}")
        }
        if st != "todo" and st != "doing" and st != "done" {
            fail("Error: bad status '{st}'")
        }
        let created = now_iso()
        db.exec(db, "INSERT INTO tasks (title, status, created) VALUES (?, ?, ?)", [title, st, created])
        count = count + 1
    }
    print("Imported {count} tasks from {arg}")
}

let cmd = getenv("TASKMAN_CMD", "")
let arg = getenv("TASKMAN_ARG", "")
let dbpath = getenv("TASKMAN_DB", "./tasks.db")

let db = db.open(dbpath)
db.exec(db, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, status TEXT NOT NULL, created TEXT NOT NULL)")

if cmd == "" or cmd == "help" {
    usage()
} else {
    if cmd == "add" {
        if arg == "" {
            fail("Error: title required")
        }
        let created = now_iso()
        db.exec(db, "INSERT INTO tasks (title, status, created) VALUES (?, ?, ?)", [arg, "todo", created])
        let last = db.query(db, "SELECT id FROM tasks ORDER BY id DESC LIMIT 1")
        let nid = last[0].id
        print("Added #{nid}: {arg}")
    } else {
        if cmd == "list" {
            let rows = db.query(db, "SELECT id, title, status, created FROM tasks ORDER BY id")
            if len(rows) == 0 {
                print("No tasks.")
            } else {
                for r in rows {
                    print("#{r.id} [{r.status}] {r.title}")
                }
            }
        } else {
            if cmd == "doing" or cmd == "done" {
                do_mark(db, arg, cmd)
            } else {
                if cmd == "delete" {
                    do_delete(db, arg)
                } else {
                    if cmd == "export" {
                        do_export(db, arg)
                    } else {
                        if cmd == "import" {
                            do_import(db, arg)
                        } else {
                            print("Error: unknown command '{cmd}'")
                            usage()
                            throw { code: "EUSER", message: "unknown command" }
                        }
                    }
                }
            }
        }
    }
}
