// Probe: iterate json.parse result directly; heterogeneous db bind
table tasks {
    id: Int @primary,
    title: Text,
    status: Text,
    created: Text,
}
let items = json.parse("[1, 2, 3]")
var count = 0
for item in items {
    count = count + 1
    print("item={item}")
}
print("count={count}")

let dbh = db.open("/tmp/probe2-tm.db")
db.exec(dbh, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, status TEXT NOT NULL, created TEXT NOT NULL)")
db.exec(dbh, "DELETE FROM tasks")
db.exec(dbh, "INSERT INTO tasks (title, status, created) VALUES (?, ?, ?)", ["x", "todo", "t"])
let id: Int = 1
let ch = db.exec(dbh, "UPDATE tasks SET status = ? WHERE id = ?", ["doing", id])
print("changed={ch}")
let rr = db.query(dbh, "SELECT id FROM tasks WHERE id = ?", [id])
print("found={len(rr)}")
