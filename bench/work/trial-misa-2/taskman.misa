// taskman — CLI task manager (bench trial-misa-2).
// Driven entirely by env vars: TASKMAN_CMD, TASKMAN_ARG, TASKMAN_DB.

table tasks {
    id: Int @primary,
    title: Text,
    status: Text,
    created: Text,
}

// Print an Error: line and exit 1 (uncaught throw -> exit 1, no traceback).
fn fail(msg: Text) {
    print(msg)
    throw { code: "E999", message: msg }
}

fn get_env(name: Text, def: Text) -> Text {
    var v = def
    try {
        v = env(name)
    } catch e {
        v = def
    }
    return v
}

// Returns the id as Int, or -1 when s is not a positive-integer literal.
fn parse_id(s: Text) -> Int {
    if len(s) == 0 {
        return -1
    }
    var i = 0
    while i < len(s) {
        let code = str.ord(str.slice(s, i, i + 1))
        if code < 48 or code > 57 {
            return -1
        }
        i = i + 1
    }
    return int(s)
}

fn usage() {
    print("Usage: set TASKMAN_CMD to one of:")
    print("  add <title>   - add a task (TASKMAN_ARG is the title)")
    print("  list          - list all tasks")
    print("  doing <id>    - mark task as doing (TASKMAN_ARG is the id)")
    print("  done <id>     - mark task as done (TASKMAN_ARG is the id)")
    print("  delete <id>   - delete a task (TASKMAN_ARG is the id)")
    print("  export <file> - export tasks to a JSON file (TASKMAN_ARG is the path)")
    print("  import <file> - import tasks from a JSON file (TASKMAN_ARG is the path)")
    print("Env: TASKMAN_CMD, TASKMAN_ARG, TASKMAN_DB (default ./tasks.db)")
}

let cmd = get_env("TASKMAN_CMD", "")
let arg = get_env("TASKMAN_ARG", "")
let dbpath = get_env("TASKMAN_DB", "./tasks.db")

var dbh = db.open(":memory:")
try {
    dbh = db.open(dbpath)
    db.exec(dbh, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, status TEXT NOT NULL, created TEXT NOT NULL)")
} catch e {
    fail("Error: cannot open database '{dbpath}'")
}

if cmd == "" or cmd == "help" {
    usage()
} else {
    if cmd == "add" {
        if arg == "" {
            fail("Error: title required")
        }
        let created = time.format(time.now(), "%Y-%m-%dT%H:%M:%S")
        db.exec(dbh, "INSERT INTO tasks (title, status, created) VALUES (?, ?, ?)", [arg, "todo", created])
        let rows = db.query(dbh, "SELECT id FROM tasks ORDER BY id DESC LIMIT 1")
        let nid = rows[0].id
        print("Added #{nid}: {arg}")
    } else {
        if cmd == "list" {
            let rows = db.query(dbh, "SELECT id, title, status FROM tasks ORDER BY id")
            if len(rows) == 0 {
                print("No tasks.")
            } else {
                for r in rows {
                    print("#{r.id} [{r.status}] {r.title}")
                }
            }
        } else {
            if cmd == "doing" or cmd == "done" {
                let id = parse_id(arg)
                if id <= 0 {
                    fail("Error: bad id '{arg}'")
                }
                let changed = db.exec(dbh, "UPDATE tasks SET status = '{cmd}' WHERE id = {id}")
                if changed == 0 {
                    fail("Error: no task #{arg}")
                }
                print("Marked #{arg} as {cmd}")
            } else {
                if cmd == "delete" {
                    let id = parse_id(arg)
                    if id <= 0 {
                        fail("Error: bad id '{arg}'")
                    }
                    let changed = db.exec(dbh, "DELETE FROM tasks WHERE id = {id}")
                    if changed == 0 {
                        fail("Error: no task #{arg}")
                    }
                    print("Deleted #{arg}")
                } else {
                    if cmd == "export" {
                        if arg == "" {
                            fail("Error: file required")
                        }
                        let rows = db.query(dbh, "SELECT id, title, status, created FROM tasks ORDER BY id")
                        try {
                            fs.write(arg, json.stringify(rows))
                        } catch e {
                            fail("Error: cannot write '{arg}'")
                        }
                        print("Exported {len(rows)} tasks to {arg}")
                    } else {
                        if cmd == "import" {
                            var content = ""
                            try {
                                content = fs.read(arg)
                            } catch e {
                                fail("Error: cannot read '{arg}'")
                            }
                            let trimmed = str.trim(content)
                            if len(trimmed) == 0 or str.slice(trimmed, 0, 1) != "[" {
                                fail("Error: bad JSON in '{arg}'")
                            }
                            var items = json.parse("[]")
                            var parse_ok = true
                            try {
                                items = json.parse(trimmed)
                            } catch e {
                                parse_ok = false
                            }
                            if not parse_ok {
                                fail("Error: bad JSON in '{arg}'")
                            }
                            var count = 0
                            let now = time.format(time.now(), "%Y-%m-%dT%H:%M:%S")
                            for item in items {
                                var title = ""
                                try {
                                    title = str(item.title)
                                } catch e {
                                    title = ""
                                }
                                var status = "todo"
                                try {
                                    status = str(item.status)
                                } catch e {
                                    status = "todo"
                                }
                                if status != "todo" and status != "doing" and status != "done" {
                                    fail("Error: bad status '{status}'")
                                }
                                var created = now
                                try {
                                    created = str(item.created)
                                } catch e {
                                    created = now
                                }
                                db.exec(dbh, "INSERT INTO tasks (title, status, created) VALUES (?, ?, ?)", [title, status, created])
                                count = count + 1
                            }
                            print("Imported {count} tasks from {arg}")
                        } else {
                            print("Error: unknown command '{cmd}'")
                            usage()
                            throw { code: "E999", message: "unknown command '{cmd}'" }
                        }
                    }
                }
            }
        }
    }
}

db.close(dbh)
