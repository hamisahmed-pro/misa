// Are We Fast Yet: Mandelbrot benchmark, ported from Python.
// Reference: /tmp/awfy/benchmarks/Python/mandelbrot.py
// Standard AWFY input size: 500. Expected: 191.
//
// Misa notes:
// - No `<<` or `^` (xor) operators. `byte_acc << 1` becomes
//   `byte_acc * 2`; `_sum ^= byte_acc` uses xor8() below, which
//   xors two bytes via bit extraction (Int / Int truncates).
// - `byte_acc <<= 8 - bit_num` becomes `byte_acc * pow2(8 - bit_num)`.

fn pow2(n: Int) -> Int {
  var r = 1
  var i = 0
  while i < n {
    r = r * 2
    i = i + 1
  }
  return r
}

fn xor8(a: Int, b: Int) -> Int {
  var result = 0
  var bit = 1
  var aa = a
  var bb = b
  while bit < 256 {
    if (aa % 2) != (bb % 2) {
      result = result + bit
    }
    aa = aa / 2
    bb = bb / 2
    bit = bit * 2
  }
  return result
}

fn mandelbrot(size: Int) -> Int {
  var acc = 0
  var byte_acc = 0
  var bit_num = 0
  var y = 0
  while y < size {
    let ci = (2.0 * y / size) - 1.0
    var x = 0
    while x < size {
      var zrzr = 0.0
      var zi = 0.0
      var zizi = 0.0
      let cr = (2.0 * x / size) - 1.5
      var z = 0
      var not_done = true
      var escape = 0
      while not_done and z < 50 {
        let zr = zrzr - zizi + cr
        zi = 2.0 * zr * zi + ci
        zrzr = zr * zr
        zizi = zi * zi
        if zrzr + zizi > 4.0 {
          not_done = false
          escape = 1
        }
        z = z + 1
      }
      byte_acc = (byte_acc * 2) + escape
      bit_num = bit_num + 1
      if bit_num == 8 {
        acc = xor8(acc, byte_acc)
        byte_acc = 0
        bit_num = 0
      } else {
        if x == size - 1 {
          byte_acc = byte_acc * pow2(8 - bit_num)
          acc = xor8(acc, byte_acc)
          byte_acc = 0
          bit_num = 0
        }
      }
      x = x + 1
    }
    y = y + 1
  }
  return acc
}

let result = mandelbrot(500)
print("mandelbrot result: {result}")
if result == 191 {
  print("VERIFY: PASS")
} else {
  print("VERIFY: FAIL (expected 191)")
}
